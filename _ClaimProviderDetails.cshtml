    function OpenNetworkHospitals() {
        try {

            const windowName = 'Provider Requests'; // Name of the new window
            const windowSize = 'width=900,height=550,left=100,top=100'; // Window dimensions: 800px width and 600px height
            var paramString = [
                0, 0, $('#hdnUserRegionID').val()
            ].join('|');
            $.ajax({
                url: '/Common/EncryptParameters',
                type: 'POST',
                data: { Q: paramString },
                success: function (encryptedValue) {
                    if (encryptedValue) {
                        if ($('#hdnAppURL').val().toUpperCase().match('20.198.75.184')) {
                            window.open('https://20.198.75.184/Provider/NonNetWorkProvider?Q=' + encodeURIComponent(encryptedValue), windowName, windowSize);
                        }
                        else {
                            window.open('/Provider/NonNetWorkProvider?Q=' + encodeURIComponent(encryptedValue), windowName, windowSize);
                        }
                    }
                    else {
                        DialogWarningMessage('Error encrypting parameter details');
                    }
                },
                error: function (err) {
                    DialogWarningMessage('Encryption failed');
                }
            });
        } catch (e) {
            alert('Error occured while add DMS document');
        }
    }
