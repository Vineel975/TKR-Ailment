                    mdate = Createddatetime; //dtServiceDiscount[i].Createddatetime.split("T")[0];
                    html = DisplayDateasIcon_DayandMonthYear(mdate);

                }
                if (ModifiedDate != null && ModifiedDate != undefined && ModifiedDate != '') {
                    mdate = ModifiedDate; //dtServiceDiscount[i].ModifiedDate.split("T")[0];
                    Modifiedhtml = DisplayDateasIcon_DayandMonthYear(mdate);
                }

                var body = '<tr id="tr_' + dtServiceDiscount[i].ServiceID + "_" + i + '" class="' + className + '"  style="color:' + color + ' !important;font-size:14px !important;">'
