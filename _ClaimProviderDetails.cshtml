                }
                else {
                    CreatedUserName = strServiceCreatedUserName ;
                }


                if ((Discount > 0 || OPDiscount > 0) && dtServiceDiscount[i].Createddatetime != null) {
                    Createddatetime = dtServiceDiscount[i].Createddatetime;
                }
                else {
                    Createddatetime = strServiceCreateddatetime;
                }


                if ((Discount > 0 || OPDiscount > 0) && dtServiceDiscount[i].ModifiedUserName != null) {
                    ModifiedUserName = dtServiceDiscount[i].ModifiedUserName;
                }
                else {
                    ModifiedUserName = strServiceModifiedUserName;
                }

                if ((Discount > 0 || OPDiscount > 0) && dtServiceDiscount[i].ModifiedDate != null) {
