    function BindDropdown(Data, control) {
        $("#" + control + " :gt(0)").remove();
        if (Data != null) {
            $.each(Data, function (i) {
                if (Data[0].ParentID == undefined) {
                    var optionhtml = '<option value="' +
                Data[i].ID + '">' + Data[i].Name + '</option>';
                    $("#" + control).append(optionhtml);
                }
